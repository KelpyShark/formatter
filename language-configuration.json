{
    "comments": {
        "lineComment": "#",
        "blockComment": ["###", "###"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(?:\\b(?:if|elif|else|while|for|def|class|try|catch)\\b.*(?:\\{|:)\\s*(?:#.*)?|.*\\{\\s*)$",
        "decreaseIndentPattern": "^\\s*(?:\\}|end\\b|elif\\b|else\\b|catch\\b)"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:\\b(?:if|elif|else|while|for|def|class|try|catch)\\b.*(?:\\{|:)\\s*(?:#.*)?|.*\\{\\s*)$",
            "action": { "indent": "indent" }
        }
    ],
    "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}
