{
    "name": "ks-formatter",
    "displayName": "KelpyShark Formatter",
    "description": "Formatter and language support for KelpyShark (.ks) files",
    "version": "0.1.0",
    "publisher": "kelpyshark",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/KelpyShark/formatter"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Formatters",
        "Programming Languages"
    ],
    "activationEvents": [],
    "main": "./out/src/extension",
    "contributes": {
        "languages": [
            {
                "id": "kelpyshark",
                "aliases": [
                    "KelpyShark",
                    "kelpy",
                    "ks"
                ],
                "extensions": [
                    ".ks"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "kelpyshark",
                "scopeName": "source.kelpyshark",
                "path": "./syntaxes/kelpyshark.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "extension.format-kelpyshark",
                "title": "Format KelpyShark File",
                "category": "KelpyShark"
            }
        ],
        "keybindings": [
            {
                "command": "extension.format-kelpyshark",
                "key": "shift+alt+f",
                "when": "editorLangId == kelpyshark"
            }
        ],
        "configuration": {
            "title": "KelpyShark Formatter",
            "properties": {
                    "kelpyshark.formatter.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Format KelpyShark files on save."
                },
                "kelpyshark.formatter.indentSize": {
                    "type": "number",
                    "default": 4,
                    "description": "Number of spaces per indentation level."
                },
                "kelpyshark.formatter.insertFinalNewline": {
                    "type": "boolean",
                    "default": false,
                    "description": "Insert a final newline at end of file."
                },
                "kelpyshark.formatter.trimTrailingWhitespace": {
                    "type": "boolean",
                    "default": true,
                    "description": "Trim trailing whitespace on save."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile",
        "pretest": "npm run compile",
        "test": "node -r ./test/mock-vscode.js ./out/src/test/formatter.test.js"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.0.0"
    }
}
