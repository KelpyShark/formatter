{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "KelpyShark",
    "scopeName": "source.kelpyshark",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#numbers" },
        { "include": "#function-def" },
        { "include": "#class-def" },
        { "include": "#function-call" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.kelpyshark",
                    "begin": "###",
                    "end": "###",
                    "beginCaptures": { "0": { "name": "punctuation.definition.comment.kelpyshark" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.comment.kelpyshark" } }
                },
                {
                    "name": "comment.line.number-sign.kelpyshark",
                    "match": "#.*$"
                },
                {
                    "name": "comment.line.double-slash.kelpyshark",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.kelpyshark",
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.kelpyshark" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.kelpyshark" } },
                    "patterns": [
                        {
                            "name": "constant.character.escape.kelpyshark",
                            "match": "\\\\."
                        },
                        {
                            "name": "variable.other.interpolated.kelpyshark",
                            "match": "\\{\\$[a-zA-Z_][a-zA-Z0-9_]*\\}"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.kelpyshark",
                    "begin": "'",
                    "end": "'",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.kelpyshark" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.kelpyshark" } },
                    "patterns": [
                        {
                            "name": "constant.character.escape.kelpyshark",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.kelpyshark",
                    "match": "\\b(if|elif|else|while|for|in|break|continue|return|try|catch|throw|import|from|class|new|self|null)\\b"
                },
                {
                    "name": "keyword.declaration.kelpyshark",
                    "match": "\\b(def)\\b"
                },
                {
                    "name": "keyword.operator.logical.kelpyshark",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "keyword.other.kelpyshark",
                    "match": "\\b(print)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.kelpyshark",
                    "match": "\\b(len|type|str|num|int|float|range|abs|sqrt|floor|ceil|round|min|max|pow|input|push|read_file|write_file|append_file|file_exists)\\b(?=\\s*\\()"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.kelpyshark",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.kelpyshark",
                    "match": "\\bnull\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.compound.kelpyshark",
                    "match": "(\\+=|-=|\\*=|/=)"
                },
                {
                    "name": "keyword.operator.comparison.kelpyshark",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.assignment.kelpyshark",
                    "match": "(?<![=!<>])=(?!=)"
                },
                {
                    "name": "keyword.operator.arithmetic.kelpyshark",
                    "match": "(\\+|-|\\*|/|%)"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.kelpyshark",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.kelpyshark",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "function-def": {
            "patterns": [
                {
                    "name": "entity.name.function.kelpyshark",
                    "match": "(?<=\\bdef\\s)[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },
        "class-def": {
            "patterns": [
                {
                    "name": "entity.name.type.class.kelpyshark",
                    "match": "(?<=\\bclass\\s)[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "name": "entity.name.function.call.kelpyshark",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.kelpyshark",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
